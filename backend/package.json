{
  "name": "san-rafael-turnos-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "node --test \"tests/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "build": "node -e \"console.log('backend build ok')\"",
    "migrate": "node src/db/migrate.js",
    "db:migrate": "node src/db/migrate.js",
    "db:status": "node src/db/status.js",
    "db:validate": "node src/db/validate.js",
    "db:rollback": "node src/db/rollback.js",
    "seed": "node src/seed/seed.js",
    "audit:db-schema": "node scripts/db_audit_schema.mjs",
    "test:hold-lock": "node scripts/test_hold_lock_e2e.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "sequelize": "^6.37.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
